# THE FOCUX Agent — provider configuration
# Copy this file to `.env` and fill in ONE provider. Never commit `.env`.

# --- DeepSeek (one step: uncomment + add your key) ---
FOCUX_PROVIDER=deepseek
FOCUX_API_KEY=sk-your-deepseek-key-here
# optional overrides:
# FOCUX_MODEL=deepseek-chat        # or deepseek-reasoner
# FOCUX_BASE_URL=https://api.deepseek.com/v1

# --- Qwen Token Plan (Aliyun Bailian) ---
# FOCUX_PROVIDER=qwen
# FOCUX_API_KEY=sk-your-token-plan-key

# --- OpenAI ---
# FOCUX_PROVIDER=openai
# FOCUX_API_KEY=sk-your-openai-key

# --- Local, keyless (default) ---
# FOCUX_PROVIDER=ollama
# FOCUX_OLLAMA_MODEL=qwen3.5
